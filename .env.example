# --- Shopify Storefront API (required to go live) -------------------------
# Your store's myshopify domain, e.g. kayra-store.myshopify.com
SHOPIFY_STORE_DOMAIN=
# From the Headless sales channel → Storefront API. Use either token.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
# Optional (defaults shown)
SHOPIFY_API_VERSION=2026-07
SHOPIFY_REVALIDATE_SECONDS=300

# --- Instant updates when you edit products in Shopify (recommended) -------
# Signing key shown under Settings → Notifications → Webhooks
SHOPIFY_WEBHOOK_SECRET=
# Any random string, for a manual refresh: POST /api/revalidate?secret=...
REVALIDATE_SECRET=

# --- Admin API (optional) ----------------------------------------------------
# Used by newsletter signups (write_customers) and by `npm run shopify:setup`
# (write_metaobject_definitions, write_metaobjects). Custom app token:
SHOPIFY_ADMIN_ACCESS_TOKEN=
# …or, for a Dev Dashboard app, its client credentials (setup script only):
SHOPIFY_ADMIN_CLIENT_ID=
SHOPIFY_ADMIN_CLIENT_SECRET=

# --- Site ------------------------------------------------------------------
# Public URL, used for SEO tags and the sitemap (e.g. https://kayra.com)
NEXT_PUBLIC_SITE_URL=
# Force an adapter: "mock" (demo data) or "shopify". Leave empty to use
# Shopify automatically whenever the credentials above are set.
SHOP_ADAPTER=
